# Normalize line endings: store as LF, checkout as LF on all platforms.
# This repo deploys to Linux — CRLF in scripts and config files breaks execution.
* text=auto eol=lf

# Force LF for files that must not have CRLF on any platform
*.py   text eol=lf
*.sh   text eol=lf
*.toml text eol=lf
*.ini  text eol=lf
*.cfg  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.mako text eol=lf
Caddyfile text eol=lf
*.service text eol=lf

# Binary files — never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
