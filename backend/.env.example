# Copy to .env and fill in values. NEVER commit .env to version control.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://viveka:CHANGE_ME@localhost:5432/viveka

# Secret key for signing session tokens — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_32

# Comma-separated allowlist of emails permitted to log in (no open registration)
ALLOWED_EMAILS=your@email.com

# Environment: 'development' enables SQL echo and /docs endpoint
ENVIRONMENT=production

# Anthropic API key — only required when LLM features are active (Phase 4+)
# ANTHROPIC_API_KEY=sk-ant-...

# LLM cost ceiling in INR (default: 500 — hard cap, breaching is a defect)
# LLM_COST_CEILING_INR=500.0
# LLM_WARN_THRESHOLD_INR=350.0

# USD/INR fallback rate if live FX fetch fails
# USD_TO_INR_FALLBACK=84.0
