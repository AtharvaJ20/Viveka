# Viveka — Oracle Cloud production environment template
# Copy to /srv/viveka/.env on the server and fill in all CHANGE_ME values.
# NEVER commit the filled .env file to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL on localhost (no remote access). Password set during bootstrap.sh.
DATABASE_URL=postgresql://viveka:CHANGE_ME@localhost:5432/viveka

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python3.11 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_32

# ── Access control ────────────────────────────────────────────────────────────
# Comma-separated list of emails allowed to log in. No open registration path.
ALLOWED_EMAILS=your@email.com

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=production
SESSION_EXPIRE_DAYS=30

# ── LLM — Phase 4+ only ───────────────────────────────────────────────────────
# Leave commented out until Phase 4 is deployed.
# Hard ceiling: ₹500/month. Breaching it is a defect, not an overage.
# ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
# LLM_COST_CEILING_INR=500.0
# LLM_WARN_THRESHOLD_INR=350.0
# USD_TO_INR_FALLBACK=84.0
